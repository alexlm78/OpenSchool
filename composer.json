{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.6",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "spatie/laravel-permission": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/larastan": "^2.0||^3.0@dev",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "sh -lc 'echo \"==> Attempting to start infra (Podman)...\"; if podman machine start >/dev/null 2>&1 || true; then if podman container exists oschool-db >/dev/null 2>&1 && podman container exists oschool-redis >/dev/null 2>&1; then podman start oschool-db oschool-redis >/dev/null 2>&1 || true; else podman compose up -d >/dev/null 2>&1 || true; fi; fi; echo \"==> Infra done (errors ignored if Podman unavailable). Starting services...\"'",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"sh -lc 'until php artisan queue:work --tries=1 --timeout=0; do echo \\\"[queue] DB not ready or worker crashed. Restarting in 3s...\\\"; sleep 3; done'\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "infra": [
            "Composer\\Config::disableProcessTimeout",
            "sh -lc 'podman machine start >/dev/null 2>&1 || true; if podman container exists oschool-db >/dev/null 2>&1 && podman container exists oschool-redis >/dev/null 2>&1; then podman start oschool-db oschool-redis; else podman compose up -d; fi'"
        ],
        "infra:down": [
            "Composer\\Config::disableProcessTimeout",
            "sh -lc 'podman machine start >/dev/null 2>&1 || true; if podman container exists oschool-db >/dev/null 2>&1 && podman container exists oschool-redis >/dev/null 2>&1; then podman stop oschool-db oschool-redis >/dev/null 2>&1 || true; else podman compose down >/dev/null 2>&1 || true; fi'"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": [
            "./vendor/bin/pint --test"
        ],
        "lint:fix": [
            "./vendor/bin/pint"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
